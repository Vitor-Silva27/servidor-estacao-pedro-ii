# Copie para .env na VPS e preencha. Nunca commite o .env.
# Gere segredos com: openssl rand -hex 32

# --- Domínio e HTTPS (DuckDNS) ---
DOMAIN=estacao-pedro.duckdns.org
DUCKDNS_TOKEN=cole-o-token-do-duckdns
ACME_EMAIL=seu-email@exemplo.com
# Porta pública da API. A URL final é https://DOMAIN:PUBLIC_PORT
PUBLIC_PORT=8443

# --- Banco (só acessível dentro da rede do Compose) ---
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# --- API ---
PORT=3333
JWT_ACCESS_SECRET=troque-por-64-hex
JWT_REFRESH_SECRET=troque-por-outros-64-hex
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- Admin criado pelo seed ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-por-uma-senha-forte
